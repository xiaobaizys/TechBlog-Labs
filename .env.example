# ============================================================
# VitaLog 环境变量模板
# 复制为 .env.local 并填入你自己的值
# ============================================================

# NextAuth v5 Secret（必填）
# 生成方式: openssl rand -base64 32
AUTH_SECRET="在此填入你的密钥"
NEXTAUTH_SECRET="在此填入你的密钥"

# 站点 URL
NEXTAUTH_URL="http://localhost:3000"

# PostgreSQL 数据库连接
DATABASE_URL="postgresql://用户名:密码@localhost:5432/techblog_labs?schema=public"
DIRECT_URL="postgresql://用户名:密码@localhost:5432/techblog_labs?schema=public"

# Redis（可选，不填默认连 localhost:6379）
# REDIS_URL="redis://localhost:6379"
# 如果没有 Redis，可禁用验证码和限流功能：
# REDIS_DISABLED="1"

# GitHub OAuth（可选）
AUTH_GITHUB_ID="你的GitHub OAuth App Client ID"
AUTH_GITHUB_SECRET="你的GitHub OAuth App Client Secret"

# AI 大模型 API Key（可选，用于博客小精灵）
# DEEPSEEK_API_KEY="sk-xxx"

# 站点公开 URL（用于 RSS、Sitemap 等生成绝对 URL）
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Sentry 错误监控（可选，生产环境推荐）
# 在 https://sentry.io 创建项目后获取 DSN
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_AUTH_TOKEN="xxx"  # 用于源码映射上传（可选）
